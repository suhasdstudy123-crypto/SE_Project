# Copy this file to ".env" and fill in YOUR values. Never commit .env.
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# If PASSWORD has @ : / # or %, write @ as %40, : as %3A, / as %2F, # as %23, % as %25
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/student_records
SECRET_KEY=change-me-to-any-long-random-text
